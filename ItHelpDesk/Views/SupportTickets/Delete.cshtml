@model ItHelpDesk.Models.SupportTickets

@{
    ViewData["Title"] = "Delete Ticket";
}

<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-danger text-white rounded-top-4">
            <h3 class="mb-0">Delete Support Ticket</h3>
        </div>

        <div class="card-body p-4">
            <div class="alert alert-warning">
                Are you sure you want to delete this ticket?
            </div>

            <h4 class="fw-bold text-primary">@Model.Title</h4>
            <hr />

            <p><strong>Description:</strong> @Model.Description</p>
            <p><strong>Category:</strong> @Model.Category</p>
            <p><strong>Priority:</strong> @Model.Priority</p>
            <p><strong>Status:</strong> @Model.Status</p>
            <p><strong>Created Date:</strong> @Model.CreatedDate.ToString("yyyy-MM-dd HH:mm")</p>
            <p><strong>Assigned To:</strong> @Model.AssignedTo</p>

            <form asp-action="Delete" class="mt-4">
                <input type="hidden" asp-for="Id" />

                <button type="submit" class="btn btn-danger rounded-pill px-4">
                    Confirm Delete
                </button>

                <a asp-action="Index" class="btn btn-secondary rounded-pill px-4">
                    Cancel
                </a>
            </form>
        </div>
    </div>
</div>