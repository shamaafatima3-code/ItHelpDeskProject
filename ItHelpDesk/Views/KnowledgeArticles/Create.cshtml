@model ItHelpDesk.Models.KnowledgeArticle

@{
    ViewData["Title"] = "Create Article";
}

<div class="container mt-5">

    <div class="card shadow-lg border-0 rounded-4">

        <div class="card-header bg-primary text-white rounded-top-4">
            <h3>Create Knowledge Base Article</h3>
        </div>

        <div class="card-body p-4">

            <form asp-action="Create">

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-bold"></label>

                    <input asp-for="Title"
                           class="form-control"
                           placeholder="Example: How to reset password" />

                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Category" class="form-label fw-bold"></label>

                    <select asp-for="Category" class="form-select">
                        <option>Authentication</option>
                        <option>Hardware</option>
                        <option>Software</option>
                        <option>Network</option>
                        <option>Email</option>
                        <option>AI Support</option>
                        <option>Security</option>
                        <option>Other</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label asp-for="Content" class="form-label fw-bold"></label>

                    <textarea asp-for="Content"
                              class="form-control"
                              rows="8"
                              placeholder="Write troubleshooting steps here..."></textarea>

                    <span asp-validation-for="Content" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CreatedBy" class="form-label fw-bold"></label>

                    <input asp-for="CreatedBy"
                           class="form-control"
                           placeholder="Admin or IT Support" />
                </div>

                <button type="submit"
                        class="btn btn-primary rounded-pill px-4">
                    Create Article
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary rounded-pill px-4">
                    Back to List
                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}