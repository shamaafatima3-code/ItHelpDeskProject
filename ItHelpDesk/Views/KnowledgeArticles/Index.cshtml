@model IEnumerable<ItHelpDesk.Models.KnowledgeArticle>

@{
    ViewData["Title"] = "Knowledge Base";
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary">Knowledge Base</h2>

        <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow">
            + Create Article
        </a>
    </div>

    <form asp-action="Index" method="get" class="d-flex mb-4">
        <input type="text"
               name="searchString"
               class="form-control me-2"
               placeholder="Search articles..." />

        <button type="submit" class="btn btn-dark rounded-pill px-4">
            Search
        </button>
    </form>

    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body p-4">

            @if (Model.Any())
            {
                foreach (var item in Model)
                {
                    <div class="border-bottom py-3">
                        <h5 class="fw-bold">@item.Title</h5>
                        <p class="text-muted mb-1">@item.Category</p>
                        <p>@item.Content</p>

                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">
                            Details
                        </a>

                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">
                            Edit
                        </a>

                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">
                            Delete
                        </a>
                    </div>
                }
            }
            else
            {
                <p class="text-muted">No articles yet.</p>
            }

        </div>
    </div>

</div>