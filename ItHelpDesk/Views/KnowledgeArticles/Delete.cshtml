@model ItHelpDesk.Models.KnowledgeArticle

@{
    ViewData["Title"] = "Delete Article";
}

<div class="container mt-5">

    <div class="card shadow-lg border-0 rounded-4">

        <div class="card-header bg-danger text-white rounded-top-4">
            <h3 class="mb-0">Delete Knowledge Article</h3>
        </div>

        <div class="card-body p-4">

            <div class="alert alert-warning">
                Are you sure you want to delete this article?
            </div>

            <h3 class="fw-bold text-primary">
                @Model.Title
            </h3>

            <p class="text-muted">
                Category: @Model.Category
            </p>

            <hr />

            <p style="white-space: pre-line;">
                @Model.Content
            </p>

            <hr />

            <p>
                <strong>Created By:</strong> @Model.CreatedBy
            </p>

            <p>
                <strong>Created Date:</strong> @Model.CreatedDate.ToString("yyyy-MM-dd HH:mm")
            </p>

            <form asp-action="Delete" class="mt-4">
                <input type="hidden" asp-for="Id" />

                <button type="submit" class="btn btn-danger rounded-pill px-4">
                    Confirm Delete
                </button>

                <a asp-action="Index" class="btn btn-secondary rounded-pill px-4">
                    Cancel
                </a>
            </form>

        </div>
    </div>
</div>